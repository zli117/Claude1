{
  "name": "stock-price-monitor",
  "version": "1.0.0",
  "description": "Desktop stock price monitoring app with technical indicators and alerts",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "yahoo-finance2": "^2.11.0",
    "lightweight-charts": "^4.1.0",
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.stockmonitor.app",
    "productName": "Stock Price Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
